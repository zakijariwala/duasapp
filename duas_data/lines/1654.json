{"subindexId":1654,"title":{"en":"New Moon","rurdu":"Chaand Raat","urdu":"چاند رات"},"lines":[{"id":1011957,"type":"text","seq":1,"desc":{"en":"Recite <Surah Mujaadela> after seeing New Moon.","rurdu":"Chaand dekhne par <Surah Mujaadela> ki tilaawat kare.","urdu":"ماہِ ربیع الاوّل کا چاند دیکھے تو <سورۂ مجادلہ> کی تلاوت کرے۔"},"minimizeDesc":true},{"id":1012083,"type":"text","seq":2,"desc":{"en":"Recite dua <Rabbi wa Rabbokallaho>.","rurdu":"Dua <Rabbi wa Rabbokallaho> padhe.","urdu":"دُعا <رَبِّیْ وَرَبُّکَ اللہُ> پڑھے۔"},"minimizeDesc":true},{"id":1018091,"type":"text","seq":3,"desc":{"en":"Recite dua <Allaahumma… Khaira Haazaa>","rurdu":"Dua <Allaahumma… Khaira Haazaa> padhe.","urdu":"<اَللّٰهُمَّ۔۔۔ خَیْرَ هٰذَا>"},"minimizeDesc":true},{"id":1018092,"type":"text","seq":4,"desc":{"en":"Recite dua <Ayyo Hal Khalqul mutee’o>","rurdu":"Dua <Ayyo Hal Khalqul mutee’o> padhe.","urdu":"<اَیُّهَا الْخَلْقُ الْمُطِیْعُ>"},"minimizeDesc":true},{"id":1011808,"type":"text","seq":5,"desc":{"en":"<1st Night Amaal> of the Lunar month.","rurdu":"Qamari mahine ki <Pehli raat ke Amaal>.","urdu":"قمری مہینےکی <پہلی رات کے اعمال>۔"},"minimizeDesc":true},{"id":4,"type":"text","seq":null}]}